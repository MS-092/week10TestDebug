{
  "expo": {
    "name": "lab2sms",
    "slug": "lab2sms",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lab2sms",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSContactsUsageDescription": "This app needs access to your contacts to let you select recipients for SMS messages.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.matt92stan.lab2sms"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0f",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.SEND_SMS"
      ],
      "package": "com.matt92stan.lab2sms"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0a0a0f",
          "dark": {
            "backgroundColor": "#0a0a0f"
          }
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "This app needs access to your contacts to let you select recipients for SMS messages."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a6fb1a42-e06e-4cfe-8a96-10c20879ed88"
      }
    },
    "owner": "matt92stan"
  }
}
